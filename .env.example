# Public, server-rendered storefront reads. No API token is needed for a public dataset.
SANITY_PROJECT_ID=your-project-id
SANITY_DATASET=production
SANITY_API_VERSION=2025-02-19

# Set this Cloudflare runtime variable to the URL printed by `npm run deploy` in /studio.
SANITY_STUDIO_URL=https://your-studio-name.sanity.studio
